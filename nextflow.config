// genome-screen Nextflow configuration

manifest {
    name            = 'genome-screen'
    author          = 'Tessa Alexanian'
    description     = 'Screen consumer-WGS for ACMG SF, ClinVar P/LP, curated risk variants, nutrigenomics, and PGx'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    // Sample inputs — required, no defaults so users must specify
    sample_vcf       = null
    sample_cram      = null
    reference_fasta  = null
    expected_build   = 'GRCh38'

    // Asset paths (relative to projectDir; users typically do not override)
    acmg_sf_yaml             = "${projectDir}/assets/acmg_sf_v3_3.yaml"
    curated_risk_yaml        = "${projectDir}/assets/curated_risk_variants.yaml"
    nutrigenomic_yaml        = "${projectDir}/assets/nutrigenomic_variants.yaml"
    reference_signatures     = "${projectDir}/assets/reference_signatures.yaml"

    // ClinVar fetch
    clinvar_url       = 'https://ftp.ncbi.nlm.nih.gov/pub/clinvar/vcf_GRCh38/clinvar.vcf.gz'
    clinvar_cache_dir = "${launchDir}/.clinvar_cache"

    // Coverage threshold for the CRAM pileup fallback in curated lookup
    min_coverage_depth = 10

    // Output
    outdir           = "${launchDir}/results"
}

profiles {
    conda {
        conda.enabled         = true
        conda.useMamba        = true
        docker.enabled        = false
        singularity.enabled   = false
    }
    docker {
        docker.enabled        = true
        docker.runOptions     = '-u $(id -u):$(id -g)'
        conda.enabled         = false
        singularity.enabled   = false
    }
    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/modules.config'

// Report / trace
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
