// Per-process configuration (publishDir, CPUs, memory)

process {
    // Sane defaults; individual modules can override
    cpus   = 1
    memory = '2 GB'
    time   = '1h'

    withName: 'REFERENCE_CHECK' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy',
            pattern: '00_reference_check.txt'
        ]
    }

    withName: 'VCF_QC' {
        cpus = 2
        memory = '4 GB'
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy',
            pattern: '01_vcf_qc.*'
        ]
    }

    withName: 'CLINVAR_INTERSECT' {
        cpus = 2
        memory = '4 GB'
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy',
            pattern: '0[23]_*.tsv'
        ]
    }

    withName: 'CURATED_LOOKUP' {
        cpus = 2
        memory = '4 GB'
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy',
            pattern: '04_*'
        ]
    }

    withName: 'NUTRIGENOMICS' {
        cpus = 2
        memory = '4 GB'
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy',
            pattern: '05_*.tsv'
        ]
    }

    withName: 'PHARMCAT' {
        cpus = 4
        memory = '8 GB'
        publishDir = [
            path: { "${params.outdir}/06_pharmcat" },
            mode: 'copy'
        ]
    }

    withName: 'REPORT' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy',
            pattern: 'report.html'
        ]
    }
}
